{
  "name": "portverdict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The model migration agent that puts every candidate branch on trial.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @portverdict/web dev",
    "build": "pnpm --filter @portverdict/web build",
    "start": "pnpm --filter @portverdict/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
