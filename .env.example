# Public application metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File-backed single-instance run store
PORTVERDICT_RUN_DIR=.portverdict-runs
PORTVERDICT_MAX_ACTIVE_RUNS=2
PORTVERDICT_MAX_REPOSITORY_BYTES=5000000

# Nebius Token Factory inference (server-side only)
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=

# Token Factory Sandboxes / ConTree (server-side only)
CONTREE_TOKEN=
CONTREE_PROJECT=
CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes/v1

# Tavily research (server-side only)
TAVILY_API_KEY=

# Optional owner-only GitHub pull-request action
GITHUB_TOKEN=
PORTVERDICT_GITHUB_OWNER=dorakingx

# Optional Nebius Serverless control-plane deployment
NEBIUS_IAM_TOKEN=
NEBIUS_SERVERLESS_ENDPOINT_ID=

